{
  "expo": {
    "name": "Pearl",
    "slug": "stablecoin-wallet",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.stablecoinwallet"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFBE45",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.example.stablecoinwallet",
      "versionCode": 2
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Use Face ID to unlock your wallet and approve payments."
        }
      ],
      "expo-image",
      "expo-video",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFBE45",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-background-task",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#FFA62B",
          "enableRemoteNotifications": false
        }
      ]
    ],
    "scheme": "stablecoinwallet"
  }
}
